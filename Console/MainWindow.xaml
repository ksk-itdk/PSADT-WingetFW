<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WingetFW Console" Width="1360" Height="860" WindowStartupLocation="CenterScreen" FontSize="12">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="2" />
        </Style>
        <Style TargetType="Label">
            <Setter Property="Padding" Value="2,4,6,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Margin" Value="2" />
            <Setter Property="Padding" Value="10,2" />
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom">
            <TextBlock x:Name="StatusText" Text="Ready" />
        </StatusBar>
        <TabControl Margin="4">
            <TabItem Header="Search and build">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Label Content="Search:" />
                        <TextBox x:Name="SearchText" Width="320" ToolTip="Name, ID, moniker or tag" />
                        <Label Content="Source:" />
                        <ComboBox x:Name="SearchSourceBox" Width="140" />
                        <Button x:Name="SearchButton" Content="Search" IsDefault="True" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="6" />
                            <ColumnDefinition Width="6*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="2*" />
                                <RowDefinition Height="2*" />
                            </Grid.RowDefinitions>
                            <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*" />
                                    <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="*" />
                                    <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4">
                                <Label Content="Version:" />
                                <ComboBox x:Name="VersionBox" Width="160" />
                            </StackPanel>
                            <TextBox x:Name="DetailsText" Grid.Row="2" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" FontFamily="Consolas" />
                            <DataGrid x:Name="InstallersGrid" Grid.Row="3" Margin="0,4,0,0" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column"
                                      ToolTip="Select an installer to use its scope, architecture and installer type">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Architecture" Binding="{Binding Architecture}" />
                                    <DataGridTextColumn Header="Type" Binding="{Binding InstallerType}" />
                                    <DataGridTextColumn Header="Nested" Binding="{Binding NestedInstallerType}" />
                                    <DataGridTextColumn Header="Scope" Binding="{Binding Scope}" />
                                    <DataGridTextColumn Header="Locale" Binding="{Binding Locale}" />
                                    <DataGridTextColumn Header="Silent switch" Binding="{Binding Silent}" />
                                    <DataGridTextColumn Header="Product code" Binding="{Binding ProductCode}" />
                                    <DataGridTextColumn Header="Elevation" Binding="{Binding ElevationRequirement}" />
                                    <DataGridTextColumn Header="Released" Binding="{Binding ReleaseDate}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
                        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <GroupBox Header="Install command">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label Content="Package ID" />
                                        <TextBox x:Name="IdText" Grid.Column="1" />
                                        <CheckBox x:Name="SourceCheck" Grid.Column="2" Content="Source" VerticalAlignment="Center" IsChecked="True" Margin="2,0,6,0" />
                                        <TextBox x:Name="SourceText" Grid.Column="3" />

                                        <Label Grid.Row="1" Content="Action" />
                                        <ComboBox x:Name="ActionBox" Grid.Row="1" Grid.Column="1" />
                                        <Label Grid.Row="1" Grid.Column="2" Content="Mode" />
                                        <ComboBox x:Name="ModeBox" Grid.Row="1" Grid.Column="3" ToolTip="Admin: Intune install behavior System. User: Intune install behavior User" />

                                        <CheckBox x:Name="ExactCheck" Grid.Row="2" Grid.Column="1" Content="-exact" IsChecked="True" VerticalAlignment="Center" Margin="2,4" />
                                        <Label Grid.Row="2" Grid.Column="2" Content="Version" />
                                        <TextBox x:Name="PinVersionText" Grid.Row="2" Grid.Column="3" ToolTip="Empty: latest version" />

                                        <Label Grid.Row="3" Content="Scope" />
                                        <ComboBox x:Name="ScopeBox" Grid.Row="3" Grid.Column="1" />
                                        <Label Grid.Row="3" Grid.Column="2" Content="Architecture" />
                                        <ComboBox x:Name="ArchitectureBox" Grid.Row="3" Grid.Column="3" />

                                        <Label Grid.Row="4" Content="Installer type" />
                                        <ComboBox x:Name="InstallerTypeBox" Grid.Row="4" Grid.Column="1" />
                                        <Label Grid.Row="4" Grid.Column="2" Content="Installer UI" />
                                        <ComboBox x:Name="InstallModeBox" Grid.Row="4" Grid.Column="3" ToolTip="Default: WingetFW adds -silent unless the DefaultSilent setting is off" />

                                        <Label Grid.Row="5" Content="Custom" />
                                        <TextBox x:Name="CustomText" Grid.Row="5" Grid.Column="1" ToolTip="Arguments added to the installer defaults (-custom)" />
                                        <Label Grid.Row="5" Grid.Column="2" Content="Override" />
                                        <TextBox x:Name="OverrideText" Grid.Row="5" Grid.Column="3" ToolTip="Replaces all installer arguments (-override); not with -silent or -interactive" />

                                        <Label Grid.Row="6" Content="Log file" />
                                        <TextBox x:Name="LogText" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" ToolTip="winget log file (-log)" />

                                        <Label Grid.Row="7" Content="Other options" />
                                        <TextBox x:Name="OtherText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" ToolTip="More WingetFW parameters, for example: -skipdependencies -locale 'en-US'" />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Commands">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <Label Content="Install" />
                                        <TextBox x:Name="InstallCommandText" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                                        <Button x:Name="CopyInstallButton" Grid.Column="2" Content="Copy" VerticalAlignment="Top" />
                                        <Label Grid.Row="1" Content="Uninstall" />
                                        <TextBox x:Name="UninstallCommandText" Grid.Row="1" Grid.Column="1" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                                        <Button x:Name="CopyUninstallButton" Grid.Row="1" Grid.Column="2" Content="Copy" VerticalAlignment="Top" />
                                        <ListBox x:Name="MessagesList" Grid.Row="2" Grid.ColumnSpan="3" MinHeight="60" MaxHeight="140" Margin="2,4,2,2" />
                                    </Grid>
                                </GroupBox>
                                <GroupBox Header="Detection script">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <RadioButton x:Name="DetectWingetRadio" Grid.ColumnSpan="2" Content="winget list (package ID)" IsChecked="True" Margin="2,4" />
                                        <RadioButton x:Name="DetectRegistryRadio" Grid.Column="2" Grid.ColumnSpan="2" Content="Uninstall registry key (HKLM)" Margin="2,4" />
                                        <Label Grid.Row="1" Content="Display name" />
                                        <TextBox x:Name="DetectNameText" Grid.Row="1" Grid.Column="1" ToolTip="DisplayName in the uninstall key, wildcards allowed" />
                                        <Label Grid.Row="1" Grid.Column="2" Content="Minimum version" />
                                        <TextBox x:Name="DetectVersionText" Grid.Row="1" Grid.Column="3" Text="0" ToolTip="0 = any version" />
                                        <TextBlock x:Name="DetectTemplateText" Grid.Row="2" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="2" />
                                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button x:Name="CopyDetectionButton" Content="Copy" />
                                            <Button x:Name="SaveDetectionButton" Content="Save as..." />
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Publish to Intune">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <GroupBox Header="Sign-in">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Tenant (optional)" />
                                <TextBox x:Name="TenantText" Width="260" ToolTip="Tenant ID or domain, for example contoso.onmicrosoft.com. Empty: your home tenant" />
                                <Button x:Name="SignInButton" Content="Sign in" />
                                <TextBlock x:Name="SignedInText" VerticalAlignment="Center" Margin="8,0" Text="Not signed in" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="WingetFW package (.intunewin)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="IntuneWinText" ToolTip="The same .intunewin is used for every WingetFW app" />
                                <Button x:Name="BrowseIntuneWinButton" Grid.Column="1" Content="Browse..." />
                                <Button x:Name="BuildIntuneWinButton" Grid.Column="2" Content="Build with IntuneWinAppUtil" ToolTip="Packs the Toolkit\WinGetFW folder; IntuneWinAppUtil.exe is downloaded from Microsoft on first use" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="App">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Label Content="Name" />
                                <TextBox x:Name="AppNameText" Grid.Column="1" />
                                <Label Grid.Column="2" Content="Publisher" />
                                <TextBox x:Name="AppPublisherText" Grid.Column="3" />
                                <Label Grid.Row="1" Content="Description" />
                                <TextBox x:Name="AppDescriptionText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="44" VerticalContentAlignment="Top" />
                                <Label Grid.Row="2" Content="Information URL" />
                                <TextBox x:Name="AppUrlText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" />
                                <Label Grid.Row="3" Content="Architecture" />
                                <ComboBox x:Name="RequirementArchBox" Grid.Row="3" Grid.Column="1" ToolTip="Intune requirement: the app only installs on these architectures" />
                                <Label Grid.Row="3" Grid.Column="2" Content="Minimum Windows" />
                                <ComboBox x:Name="MinWindowsBox" Grid.Row="3" Grid.Column="3" ToolTip="Intune requirement. winget needs Windows 10 1809 or later" />
                                <Label Grid.Row="4" Content="Install behavior" />
                                <TextBlock x:Name="InstallBehaviorText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="2" />
                                <Label Grid.Row="5" Content="Install" />
                                <TextBox x:Name="PublishInstallText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                                <Label Grid.Row="6" Content="Uninstall" />
                                <TextBox x:Name="PublishUninstallText" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                                <Label Grid.Row="7" Content="Detection" />
                                <TextBlock x:Name="PublishDetectionText" Grid.Row="7" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="2" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Assignments (optional)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Group" />
                                        <TextBox x:Name="GroupSearchText" Width="220" ToolTip="Start of the group name" />
                                        <Button x:Name="GroupSearchButton" Content="Find" />
                                    </StackPanel>
                                    <ListBox x:Name="GroupsList" Height="110" Margin="2" DisplayMemberPath="DisplayName" />
                                    <StackPanel Orientation="Horizontal">
                                        <Label Content="Intent" />
                                        <ComboBox x:Name="IntentBox" Width="120" ToolTip="Available only works for user groups" />
                                        <Button x:Name="AddAssignmentButton" Content="Add" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <DataGrid x:Name="AssignmentsGrid" Height="140" Margin="2" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Group" Binding="{Binding Group}" Width="*" />
                                            <DataGridTextColumn Header="Intent" Binding="{Binding Intent}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <Button x:Name="RemoveAssignmentButton" Content="Remove" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="PublishButton" Content="Create app in Intune" FontWeight="Bold" />
                            <TextBlock x:Name="PublishResultText" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Publish to ConfigMgr">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
                        <TextBlock TextWrapping="Wrap" Margin="2,0,2,6"
                                   Text="Creates a ConfigMgr application with the commands and the detection script of the Search and build tab. Needs the ConfigMgr console on this PC." />
                        <GroupBox Header="Site">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Site code" />
                                <TextBox x:Name="CMSiteCodeText" Width="60" />
                                <Label Content="Site server" />
                                <TextBox x:Name="CMServerText" Width="240" ToolTip="Site server with the SMS Provider, for example cm01.contoso.com" />
                                <Button x:Name="CMConnectButton" Content="Connect" />
                                <TextBlock x:Name="CMConnectedText" VerticalAlignment="Center" Margin="8,0" Text="Not connected" />
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Content (the same WingetFW package for every application)">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Label Content="Content share" />
                                <TextBox x:Name="CMShareText" Grid.Column="1" ToolTip="UNC path the site server can read, for example \\cm01\Sources\Apps" />
                                <Button x:Name="CMCopyButton" Grid.Column="2" Content="Copy package to share" />
                                <Label Grid.Row="1" Content="Content folder" />
                                <TextBlock x:Name="CMContentText" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" FontFamily="Consolas" Margin="2" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Application">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                </Grid.RowDefinitions>
                                <Label Content="Name" />
                                <TextBox x:Name="CMAppNameText" Grid.Column="1" />
                                <Label Grid.Column="2" Content="Publisher" />
                                <TextBox x:Name="CMPublisherText" Grid.Column="3" />
                                <Label Grid.Row="1" Content="Description" />
                                <TextBox x:Name="CMDescriptionText" Grid.Row="1" Grid.Column="1" />
                                <Label Grid.Row="1" Grid.Column="2" Content="Software version" />
                                <TextBox x:Name="CMVersionText" Grid.Row="1" Grid.Column="3" ToolTip="Shown in Software Center; it does not pin the version" />
                                <Label Grid.Row="2" Content="Install behavior" />
                                <TextBlock x:Name="CMBehaviorText" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="2" />
                                <Label Grid.Row="3" Content="Install" />
                                <TextBox x:Name="CMInstallText" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                                <Label Grid.Row="4" Content="Uninstall" />
                                <TextBox x:Name="CMUninstallText" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" />
                                <Label Grid.Row="5" Content="Detection" />
                                <TextBlock x:Name="CMDetectionText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" VerticalAlignment="Center" Margin="2" />
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="Distribution and deployment (optional)">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Distribution point group" />
                                <ComboBox x:Name="CMDPGroupBox" Width="220" IsEditable="True" ToolTip="Filled after Connect; empty: no distribution" />
                                <Label Content="Collection" />
                                <TextBox x:Name="CMCollectionText" Width="220" ToolTip="Empty: no deployment" />
                                <ComboBox x:Name="CMPurposeBox" Width="100" />
                            </StackPanel>
                        </GroupBox>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="CMCreateButton" Content="Create application in ConfigMgr" FontWeight="Bold" />
                            <TextBlock x:Name="CMResultText" VerticalAlignment="Center" Margin="8,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Inventory and upgrade">
                <Grid Margin="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="3*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Button x:Name="LoadInventoryButton" Content="Load WingetFW apps" FontWeight="Bold" ToolTip="Signs in with the tenant on the Publish tab if you are not signed in yet" />
                        <Label Content="Mod files ScriptRoot (optional)" Margin="12,0,0,0" />
                        <TextBox x:Name="InventoryScriptRootText" Width="360" ToolTip="Local folder, UNC share or Azure blob URL with SAS; the app mod file is &lt;ScriptRoot&gt;\&lt;source&gt;\&lt;id&gt;.ps1" />
                        <TextBlock x:Name="InventoryTargetText" VerticalAlignment="Center" Margin="12,0" />
                    </StackPanel>
                    <DataGrid x:Name="InventoryGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" HeadersVisibility="Column"
                              ToolTip="Select one or more apps (Ctrl or Shift) for the dry run or the update">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Update" Binding="{Binding Update}" />
                            <DataGridTextColumn Header="App" Binding="{Binding DisplayName}" Width="2*" />
                            <DataGridTextColumn Header="WingetFW" Binding="{Binding CurrentWingetFWVersion}" />
                            <DataGridTextColumn Header="Package" Binding="{Binding Details.Package}" Width="*" />
                            <DataGridTextColumn Header="Action" Binding="{Binding Details.Action}" />
                            <DataGridTextColumn Header="Mode" Binding="{Binding Details.Mode}" />
                            <DataGridTextColumn Header="Detection" Binding="{Binding DetectionRule}" />
                            <DataGridTextColumn Header="Assignments" Binding="{Binding Details.Intents}" />
                            <DataGridTextColumn Header="Mod file" Binding="{Binding Details.ModStatus}" />
                            <DataGridTextColumn Header="Result" Binding="{Binding Result}" Width="2*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Grid.Row="2" Text="Details of the selected app" FontWeight="Bold" Margin="2,6,2,2" />
                    <TextBox x:Name="InventoryDetailsText" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top" FontFamily="Consolas" />
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="ExportInventoryButton" Content="Export CSV..." ToolTip="Same CSV as Tools\Update-WingetFWIntuneApps.ps1 -Export; it can be used with -Apply" />
                        <Button x:Name="SelectUpdateButton" Content="Select all with Update = Yes" />
                        <Button x:Name="DryRunButton" Content="Dry run selected" ToolTip="Checks the selected apps again without changing anything" />
                        <Button x:Name="UpgradeButton" Content="Update selected in Intune..." FontWeight="Bold" ToolTip="Uploads the .intunewin from the Publish tab and sets the new command lines" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem Header="Mod files and settings">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ModAppRadio" Content="App mod" IsChecked="True" VerticalAlignment="Center" Margin="2,0,8,0" />
                            <RadioButton x:Name="ModGlobalRadio" Content="Global mod (__WingetFW.ps1)" VerticalAlignment="Center" Margin="2,0,12,0" />
                            <Label Content="Package ID" />
                            <TextBox x:Name="ModIdText" Width="180" />
                            <Label Content="Source" />
                            <TextBox x:Name="ModSourceText" Width="90" Text="winget" />
                            <Button x:Name="ModFromSearchButton" Content="From Search and build" />
                        </StackPanel>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Label Content="ScriptRoot" />
                            <TextBox x:Name="ModRootText" Grid.Column="1" ToolTip="Local folder or UNC share; it must be below one of the AllowedScriptSources" />
                            <Button x:Name="ModBrowseButton" Grid.Column="2" Content="Browse..." />
                        </Grid>
                        <StackPanel Grid.Row="2" Orientation="Horizontal">
                            <Label Content="File" />
                            <TextBlock x:Name="ModPathText" VerticalAlignment="Center" FontFamily="Consolas" />
                        </StackPanel>
                        <WrapPanel Grid.Row="3" Margin="0,2">
                            <Button x:Name="ModNewButton" Content="New from template" />
                            <Button x:Name="ModOpenButton" Content="Open file" />
                            <Button x:Name="ModCheckButton" Content="Check" />
                            <Button x:Name="ModSaveButton" Content="Save" FontWeight="Bold" />
                            <CheckBox x:Name="ModSignCheck" Content="Sign when saving" VerticalAlignment="Center" Margin="10,0,4,0" />
                            <ComboBox x:Name="ModCertBox" Width="300" DisplayMemberPath="Text" ToolTip="Code signing certificates with private key in Cert:\CurrentUser\My" />
                            <Label Content="Timestamp" />
                            <TextBox x:Name="ModTimestampText" Width="190" Text="http://timestamp.digicert.com" ToolTip="Empty: no timestamp (the signature ends when the certificate expires)" />
                        </WrapPanel>
                        <TextBox x:Name="ModEditorText" Grid.Row="4" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" TextWrapping="NoWrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" VerticalContentAlignment="Top" />
                        <ListBox x:Name="ModMessagesList" Grid.Row="5" Height="110" Margin="2,4,2,2" />
                    </Grid>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" />
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Effective settings on this PC" FontWeight="Bold" VerticalAlignment="Center" Margin="2,0,10,0" />
                            <Label Content="Mod $Settings for" />
                            <ComboBox x:Name="SettingsActionBox" Width="90" />
                            <Button x:Name="SettingsRefreshButton" Content="Refresh" />
                        </StackPanel>
                        <DataGrid x:Name="SettingsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" Margin="0,4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Setting" Binding="{Binding Name}" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Text}" Width="*" />
                                <DataGridTextColumn Header="From" Binding="{Binding Source}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Grid.Row="2" TextWrapping="Wrap" Margin="2"
                                   Text="From: Policy = HKLM\SOFTWARE\Policies\WingetFW, Mod = $Settings of the file in the editor, Local = HKLM\SOFTWARE\WingetFW, Config = WingetFW.psd1 of the package, Default = built into WingetFW. The command line is not included." />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
